NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/medivault
# Generate a random secret with at least 32 bytes before starting the API.
JWT_SECRET=replace-with-a-long-random-secret-value-before-starting
STORAGE_ENCRYPTION_KEY=replace-with-64-hex-characters-from-a-cryptographically-random-key
STORAGE_PATH=./storage

# Required for password recovery email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MediVault <no-reply@example.com>
